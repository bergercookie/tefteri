<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the agenda widget: a day with an event and two tasks.
     Only views that a RemoteViews can show. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            style="@style/TefteriAgendaArrow"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_arrow_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/agenda_preview_day"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            style="@style/TefteriAgendaArrow"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_refresh" />

        <ImageView
            style="@style/TefteriAgendaArrow"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_arrow_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agenda_preview_event"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/agenda_preview_event_time"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agenda_preview_task_one"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/agenda_preview_task_time"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agenda_preview_task_two"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
