# Copy to .env. Never commit real values.
TEFTERI_DATABASE_URL=sqlite+aiosqlite:////data/tefteri.db
TEFTERI_ADMIN_USERNAME=admin
# Generate with: just hash-password
TEFTERI_ADMIN_PASSWORD_HASH=
TEFTERI_SECRET_KEY=
TEFTERI_GOOGLE_CLIENT_ID=
TEFTERI_GOOGLE_CLIENT_SECRET=
# Only for `just deploy::up-postgres`:
# POSTGRES_PASSWORD=
# TEFTERI_DATABASE_URL=postgresql+asyncpg://tefteri:<POSTGRES_PASSWORD>@postgres:5432/tefteri
